{
  "model": {
    "d": 1000,
    "k": 100,
    "lr": 1e-3,
    "sparsity_weight": 0.1,
    "tau_init": 1.0
  },
  "data": {
    "dataset_path": "data/persona_train_dataset.pkl",
    "attribute_prompts_path": "attribute_prompts.json"
  },
  "vllm": {
    "model_name": "meta-llama/Llama-3.2-1B-Instruct",
    "gpu_memory_util": 0.6
  },
  "servers": {
    "collector": {
      "host": "g3097",
      "port": 8001,
      "device": "cuda:0"
    },
    "learner": {
      "host": "g3097", 
      "port": 8002,
      "device": "cuda:0",
      "checkpoint_dir": "./checkpoints",
      "use_wandb": false
    }
  },
  "training": {
    "max_steps": 1000,
    "log_freq": 20,
    "checkpoint_freq": 100,
    "users_per_batch": 4,
    "samples_per_user": 8,
    "queue_size": 100,
    "replay_buffer_size": 10000,
    "replay_ratio": 0.3
  },
  "monitoring": {
    "enable_monitoring": true,
    "enable_wandb": false,
    "plot_update_interval": 10.0,
    "log_level": "INFO"
  },
  "timeouts": {
    "server_health_check": 120.0,
    "server_startup_wait": 300.0,
    "get_params": 120.0,
    "generate_batch": 180.0,
    "train_step": 120.0,
    "server_status": 120.0,
    "system_check": 150.0
  }
}